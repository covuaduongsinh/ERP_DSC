# ============================================================
# apps/web — Biến môi trường (copy thành .env, KHÔNG commit .env)
# ============================================================

# Supabase PostgreSQL — connection pooler (Transaction mode, port 5432)
DATABASE_URI=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Payload CMS secret — chuỗi ngẫu nhiên ≥ 32 ký tự (tạo: openssl rand -hex 32)
PAYLOAD_SECRET=your-random-64-char-hex-secret

# URL gốc của app — dùng cho CORS/CSRF Payload + thẻ OG.
# Dev server chạy ở cổng 3005 (xem script "dev" trong package.json) → giá trị này
# phải khớp, nếu không Payload chặn đăng nhập /admin vì CORS/CSRF.
# Dev: http://localhost:3005  |  Prod: https://covuaduongsinh.com
NEXT_PUBLIC_SERVER_URL=http://localhost:3005

# Analytics — để trống để tắt
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_FB_PIXEL_ID=

# Supabase Storage — S3-compatible (lấy từ Storage > S3 Connection trong dashboard)
# Endpoint dạng: https://[PROJECT-REF].supabase.co/storage/v1/s3
S3_ENDPOINT=https://[PROJECT-REF].supabase.co/storage/v1/s3
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET=media
S3_REGION=ap-southeast-1
# URL gốc Supabase project (không có /storage/...) — dùng để tạo public URL ảnh
SUPABASE_PUBLIC_URL=https://[PROJECT-REF].supabase.co

# ============================================================
# Giai đoạn 4 — Cổng phụ huynh (SSO + OTP)
# ============================================================

# Bí mật ký session phụ huynh — TÁCH RIÊNG khỏi PAYLOAD_SECRET (staff).
# Tạo: openssl rand -hex 32. Bắt buộc ≥ 32 ký tự.
PARENT_SESSION_SECRET=your-random-64-char-hex-secret-FOR-PARENTS

# Nhà cung cấp OTP: "dev" (in OTP ra console + trả về client để test) hoặc
# "prod" (gọi gateway SMS brandname / Zalo ZNS qua HTTP). Mặc định "dev".
OTP_PROVIDER=dev

# Cấu hình prod provider — CHỈ cần khi OTP_PROVIDER=prod. Điền giá trị thật ở
# .env (KHÔNG commit). Thiếu biến bắt buộc → app fail-fast khi khởi tạo provider.
# OTP_HTTP_ENDPOINT     # (bắt buộc) URL API của gateway
# OTP_HTTP_API_KEY      # (bắt buộc) khóa bí mật, gửi qua header Authorization
# OTP_HTTP_SENDER       # (tùy chọn) brandname / sender ID
# OTP_MESSAGE_TEMPLATE  # (tùy chọn) mẫu tin, chứa {code}
# OTP_HTTP_TIMEOUT_MS   # (tùy chọn) timeout request, mặc định 8000

# ============================================================
# Tích hợp hệ sinh thái ERP (CRM handoff + event bus)
# ============================================================

# Service token CHUNG với CRM cho API nội bộ /api/internal/* (server-to-server).
# Phải đặt GIỐNG HỆT giá trị INTERNAL_API_TOKEN bên app CRM. Thiếu → endpoint trả 503.
INTERNAL_API_TOKEN=đổi-thành-secret-ngẫu-nhiên-dài

# NATS JetStream — publish covua.* (payment/attendance/renewal…) cho Accounting/CRM.
# Bỏ trống = tắt publish (dev), không ảnh hưởng ghi dữ liệu Payload.
NATS_URL=nats://localhost:4222
