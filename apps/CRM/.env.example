# Database
DATABASE_URL="postgresql://user:password@localhost:5432/prismy_crm?schema=public"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3018"

# ── Tích hợp hệ sinh thái ERP ──
# CoVua (CLB / đào tạo cờ vua) — dùng cho handoff chốt lead + đọc 360°
NEXT_PUBLIC_COVUA_URL="http://localhost:3020"
# Service token CHUNG với CoVua cho API nội bộ server-to-server (đặt GIỐNG NHAU ở 2 app)
INTERNAL_API_TOKEN="đổi-thành-secret-ngẫu-nhiên-dài"
# NATS JetStream — bật event bus (reverse-sync covua.> + publish crm.*/customer). Bỏ trống = tắt (dev).
NATS_URL="nats://localhost:4222"
# Owner mặc định cho lead đến từ form web công khai (nếu trống: tự chọn lễ tân/admin)
# INTAKE_OWNER_USER_ID="supabase-auth-user-id"

# Email (Resend)
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="Prismy CRM <noreply@your-domain.com>"
# Nếu chưa verify domain, dùng: Prismy CRM <onboarding@resend.dev>

# Seed (optional — used by `npx prisma db seed`)
# SEED_ADMIN_ID="supabase-auth-user-id-for-admin"
# SEED_MEMBER_ID="supabase-auth-user-id-for-member"
