# ============================================================
# VietERP — Biến môi trường cho docker-compose.prod.yml
# Sao chép thành .env (cùng thư mục docker-compose.prod.yml) và điền giá trị thật.
#   cp deploy/.env.prod.example .env
# Sinh secret ngẫu nhiên:  openssl rand -base64 36
# ============================================================

# ── Postgres ────────────────────────────────────────────────
POSTGRES_USER=vierp
POSTGRES_PASSWORD=ĐỔI_MẬT_KHẨU_MẠNH
POSTGRES_DB=vierp_prod

# ── Keycloak (SSO) ──────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=ĐỔI_MẬT_KHẨU_MẠNH
SSO_REALM=vierp
SSO_CLIENT_SECRET=ĐỔI_SECRET

# ── AI (cho HRM-AI & ExcelAI) ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase (CRM dùng để xác thực đăng nhập) ───────────────
# Lấy ở Supabase Cloud: Settings > API. anon key là khoá CÔNG KHAI.
# Phải có khi build CRM (build-images.sh tự đọc từ file này) + lúc chạy.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── MinIO (object storage S3-compatible — media của CoVua) ──
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=ĐỔI_MẬT_KHẨU_MẠNH

# ── Cờ vua Dương Sinh (CoVua — Next 15 + Payload CMS) ───────
# Tên miền gốc dùng để dựng URL các app (vd erp.example.vn) → covua.${BASE_DOMAIN}
BASE_DOMAIN=erp.example.vn
COVUA_PAYLOAD_SECRET=ĐỔI_SECRET_>=32_KÝ_TỰ          # openssl rand -hex 32
COVUA_PARENT_SESSION_SECRET=ĐỔI_SECRET_>=32_KÝ_TỰ   # openssl rand -hex 32 (cổng phụ huynh)
COVUA_S3_BUCKET=covua-media
COVUA_S3_REGION=ap-southeast-1
COVUA_OTP_PROVIDER=dev                              # "dev" (in OTP ra log) | "prod" (SMS/Zalo)
# Bootstrap schema LẦN ĐẦU trên DB rỗng: deploy-covua.sh tự bật true 1 lần rồi tắt.
# KHÔNG để true thường trực (dev push có thể treo khi đổi enum).
COVUA_DB_PUSH=false
# SSO Keycloak cho CoVua (Pha 3) — tạo client "covua" trong realm vierp
COVUA_SSO_CLIENT_ID=covua
COVUA_SSO_CLIENT_SECRET=ĐỔI_SECRET

# ── Tag image build local ───────────────────────────────────
IMAGE_TAG=latest

# ── LƯU Ý QUAN TRỌNG ────────────────────────────────────────
# docker-compose.prod.yml HIỆN KHÔNG truyền NEXTAUTH_SECRET/AUTH_SECRET vào các app,
# nhưng các app NextAuth CẦN biến này khi chạy production. Trước khi deploy phải bổ sung
# (mỗi app một dòng env trong compose, hoặc đặt chung):
#   NEXTAUTH_SECRET / AUTH_SECRET  (>= 32 ký tự)   ví dụ: openssl rand -base64 36
#   NEXTAUTH_URL = https://<subdomain-app>.<domain>
# Xem deploy/README.md mục "Caveat".
